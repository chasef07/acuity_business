#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

scripts/validate-skills

# Run each skill's script tests.
for scripts in skills/*/scripts; do
  if compgen -G "$scripts/test_*.py" > /dev/null; then
    env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE python3 -m unittest discover -q -s "$scripts"
  fi
done
